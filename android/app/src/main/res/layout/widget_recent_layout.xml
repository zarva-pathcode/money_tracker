<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_recent_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Header: Balance & Expenses side by side -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/widget_recent_balance_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💰"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/widget_recent_balance_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Saldo:"
                android:textColor="#888888"
                android:textSize="10sp"
                android:layout_marginStart="4dp" />
            <TextView
                android:id="@+id/widget_recent_balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rp 0"
                android:textColor="#43A047"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginStart="2dp"
                android:maxLines="1" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:background="#E0E0E0"
            android:layout_marginHorizontal="4dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/widget_recent_expense_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📊"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/widget_recent_expense_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pengeluaran:"
                android:textColor="#888888"
                android:textSize="10sp"
                android:layout_marginStart="4dp" />
            <TextView
                android:id="@+id/widget_recent_expenses"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rp 0"
                android:textColor="#EF5350"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginStart="2dp"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>

    <!-- Divider -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EEEEEE" />

    <!-- Scrollable ListView for 10 Transactions -->
    <ListView
        android:id="@+id/widget_recent_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:paddingVertical="4dp" />

    <!-- Divider -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EEEEEE" />

    <!-- Footer: Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end|center_vertical"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp">

        <!-- Voice button -->
        <ImageButton
            android:id="@+id/widget_recent_btn_voice"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_btn_speak_now"
            android:background="@drawable/widget_button_bg"
            android:scaleType="fitCenter"
            android:padding="4dp"
            android:layout_marginEnd="8dp" />

        <!-- Add button -->
        <ImageButton
            android:id="@+id/widget_recent_btn_add"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@android:drawable/ic_input_add"
            android:background="@drawable/widget_button_bg"
            android:scaleType="fitCenter"
            android:padding="4dp" />
    </LinearLayout>

</LinearLayout>
